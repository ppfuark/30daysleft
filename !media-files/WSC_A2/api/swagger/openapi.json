{
  "openapi": "3.0.3",
  "info": {
    "title": "API WS Conecta 2026",
    "version": "1.0.0",
    "description": "Documentação da API do evento WS Conecta com rotas de competidores, escolas, modalidades, categorias, medalhas, comentários e curtidas."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor Local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Comentario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "modalidadeId": {
            "type": "integer",
            "example": 1
          },
          "authorId": {
            "type": "integer",
            "example": 1
          },
          "content": {
            "type": "string",
            "example": "Ótima modalidade!"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-03T12:00:00.000Z"
          }
        }
      },
      "Curtida": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "modalidadeId": {
            "type": "integer",
            "example": 1
          },
          "competidorId": {
            "type": "integer",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-03T12:00:00.000Z"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "CreateCompetidorRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "novo.competidor@example.com"
          },
          "password": {
            "type": "string",
            "example": "senha123"
          },
          "name": {
            "type": "string",
            "example": "Novo Competidor"
          },
          "birthdate": {
            "type": "string",
            "example": "2000-01-01"
          },
          "phone": {
            "type": "string",
            "example": "(11) 98765-4321"
          },
          "modalidadeId": {
            "type": "integer",
            "example": 1
          },
          "escolaId": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "UpdateCompetidorRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe Editado"
          },
          "birthdate": {
            "type": "string",
            "example": "1990-01-01"
          },
          "phone": {
            "type": "string",
            "example": "(11) 99999-8888"
          },
          "modalidadeId": {
            "type": "integer",
            "example": 2
          },
          "escolaId": {
            "type": "integer",
            "example": 2
          },
          "avatarId": {
            "type": "integer",
            "example": 12
          },
          "email": {
            "type": "string",
            "example": "john.updated@example.com"
          }
        }
      },
      "CreateComentarioRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "example": "Excelente conteúdo sobre esta modalidade!"
          }
        }
      },
      "UploadAvatarResponse": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "example": "1725364800000_avatar.png"
          }
        }
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "filename": {
            "type": "string",
            "example": "1725364800000_avatar.png"
          },
          "originalname": {
            "type": "string",
            "example": "avatar.png"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-03T12:00:00.000Z"
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Mensagem descritiva do erro"
          }
        }
      },
      "Escola": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "SENAI"
          }
        }
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Tecnologia da Informação"
          }
        }
      },
      "Medalha": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "tipo": {
            "type": "string",
            "example": "ouro"
          },
          "data": {
            "type": "string",
            "example": "segunda-feira, 15 de Julho de '2019"
          },
          "pais": {
            "type": "string",
            "example": "Brasil"
          }
        }
      },
      "Competidor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "competidorId": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "birthdate": {
            "type": "string",
            "format": "date",
            "example": "1990-01-01"
          },
          "phone": {
            "type": "string",
            "example": "(11) 91234-5678"
          },
          "modalidadeId": {
            "type": "integer",
            "example": 1
          },
          "escolaId": {
            "type": "integer",
            "example": 1
          },
          "avatarId": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "Modalidade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Programação Mobile"
          },
          "summary": {
            "type": "string",
            "example": "Criação de aplicativos para dispositivos móveis."
          },
          "description": {
            "type": "string",
            "example": "Descrição completa da modalidade Programação Mobile."
          },
          "imageId": {
            "type": "integer",
            "example": 1
          },
          "categoriaId": {
            "type": "integer",
            "example": 1
          },
          "totalLikes": {
            "type": "integer",
            "example": 4
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Realiza login do competidor",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados de requisição inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
